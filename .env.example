# MySQL connection
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=rose_db
DATABASE_USER=root
DATABASE_PASSWORD=

# Gemini API. Keep the key on the backend and never commit a real key.
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Local development origins. The FastAPI server also serves the frontend.
FRONTEND_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
